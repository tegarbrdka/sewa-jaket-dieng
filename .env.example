# ==============================
# Database Configuration
# ==============================
DB_ROOT_PASSWORD=rootpassword
DB_NAME=sewa_jaket_dieng
DB_USER=sewa_user
DB_PASSWORD=sewa_password
DB_HOST=mysql
DB_PORT=3306

# ==============================
# Midtrans Sandbox Keys
# ==============================
# Get your keys from: https://dashboard.sandbox.midtrans.com/settings/config_info
MIDTRANS_SERVER_KEY=SB-Mid-server-YOUR_SERVER_KEY_HERE
MIDTRANS_CLIENT_KEY=SB-Mid-client-YOUR_CLIENT_KEY_HERE
MIDTRANS_IS_PRODUCTION=false

# ==============================
# Application
# ==============================
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ==============================
# Frontend (Vite)
# ==============================
VITE_API_URL=http://localhost:5000/api
VITE_MIDTRANS_CLIENT_KEY=SB-Mid-client-YOUR_CLIENT_KEY_HERE
